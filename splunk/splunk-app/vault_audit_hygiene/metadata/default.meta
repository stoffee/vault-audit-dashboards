access = read : [ admin, power, user, vault_auditor ], write : [ admin ]
export = system

[transforms]
access = read : [ admin, power, user, vault_auditor ], write : [ admin ]
export = system

[lookups]
access = read : [ admin, power, user, vault_auditor ], write : [ admin ]
export = system
