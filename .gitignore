# Local audit data. Never commit an audit log: it names real paths and identities.
*.jsonl
*.log
samples/
vault_secret_inventory.csv

# Exception: hand-crafted, synthetic test fixtures the test suite needs to run.
# No real paths or identities live here, only literal placeholder strings.
!grafana/scripts/tests/fixtures/*.jsonl

# Aggregator state
.state/
*.state.json

# Never commit a credential. If a file holds one, it does not belong in this repo.
*.pem
*.key
.env
.envrc

# OS / editor
.DS_Store
.vscode/
__pycache__/
*.pyc
*.swp
