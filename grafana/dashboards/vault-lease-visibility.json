          "id": "groupBy",
          "options": {
            "fields": {
              "lease_id": {
                "aggregations": [],
                "operation": "groupby"
              },
              "mount": {
                "aggregations": [
                  "lastNotNull"
                ],
                "operation": "aggregate"
              },
              "role": {
                "aggregations": [
                  "lastNotNull"
                ],
                "operation": "aggregate"
              },
              "bucket": {
                "aggregations": [
                  "lastNotNull"
                ],
                "operation": "aggregate"
              },
              "days_to_expiry": {
                "aggregations": [
                  "lastNotNull"
                ],
                "operation": "aggregate"
              },
              "renewable": {
                "aggregations": [
                  "lastNotNull"
                ],
                "operation": "aggregate"
              },
              "verified_engine": {
                "aggregations": [
                  "lastNotNull"
                ],
                "operation": "aggregate"
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "labels": true,
              "tsNs": true,
              "id": true,
              "Time": true,
              "job": true,
              "engine_type": true,
              "lease_id": false
            },
            "indexByName": {
              "mount (lastNotNull)": 0,
              "role (lastNotNull)": 1,
              "lease_id": 2,
              "days_to_expiry (lastNotNull)": 3,
              "bucket (lastNotNull)": 4,
              "renewable (lastNotNull)": 5,
              "verified_engine (lastNotNull)": 6
            },
            "renameByName": {
              "mount (lastNotNull)": "mount",
              "role (lastNotNull)": "role",
              "days_to_expiry (lastNotNull)": "days to expiry",
              "bucket (lastNotNull)": "bucket",
              "renewable (lastNotNull)": "renewable",
              "verified_engine (lastNotNull)": "engine verified"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "days to expiry (lastNotNull)",
                "desc": false
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
