      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 85,
            "axisLabel": "secrets"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "piechart",
      "title": "Never-read secrets by namespace",
      "description": "Where the dormant secrets live. Regulated namespaces are metadata-only, always.",
