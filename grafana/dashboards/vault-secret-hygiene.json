    },
    {
      "type": "barchart",
      "title": "Last-accessed age distribution",
      "description": "The answer to \"how many secrets has nothing read in the last eighteen months\". Bucket counts only; path is never a Prometheus label.",
      "gridPos": {
        "h": 10,
        "w": 14,
        "x": 0,
        "y": 8
      },
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vault_secret_last_read_age{job=\"vault-secret-hygiene\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "{{bucket}}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "__name__": true
            },
            "renameByName": {
              "bucket": "age bucket",
              "Value": "secrets"
            }
          }
        }
      ],
      "options": {
        "orientation": "vertical",
        "xTickLabelRotation": -30,
