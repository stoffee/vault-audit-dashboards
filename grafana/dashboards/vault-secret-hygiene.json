      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(vault_secret_verdict{job=\"vault-secret-hygiene\", verdict=~\"dormant_over_365d|dormant_over_540d\"})",
          "instant": true,
          "legendFormat": "dormant"
