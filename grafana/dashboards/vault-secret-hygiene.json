    },
    {
      "type": "table",
      "title": "Cleanup candidates. Paths only; audit logs contain no secret values.",
      "description": "Per-secret findings emitted by the aggregator as Loki log LINES: per-secret detail without per-secret label cardinality.",
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 7,
      "datasource": {
        "type": "loki",
        "uid": "loki-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"vault-secret-hygiene\", namespace=~\"$namespace\"}",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "labels": true,
              "tsNs": true,
              "id": true,
              "Time": true,
              "job": true,
              "namespace": false
            },
            "indexByName": {
              "secret": 0,
              "namespace": 1,
              "verdict": 2,
              "read_age_days": 3,
              "write_age_days": 4,
              "reads": 5,
              "writes": 6
            },
            "renameByName": {
              "read_age_days": "days since read",
              "write_age_days": "days since rotated",
              "secret": "secret path"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "writes",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
